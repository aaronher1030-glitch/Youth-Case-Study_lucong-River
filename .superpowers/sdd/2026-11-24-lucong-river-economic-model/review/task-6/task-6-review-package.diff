+def test_twenty_thousand_draw_smoke_run_completes_without_selecting_withheld_results():
+    params = replace(Params(), land_available_ha=20.0)
+    sheds = load_census(FIXTURE)
+    evaluations = enumerate_designs(params, sheds)
+    results = run_uncertainty(params, sheds, evaluations, UncertaintySpec())
+    assert results
+    for result in results.values():
+        assert result.valid_draws in (0, 20_000)
+        if result.invalid_fraction > 0:
+            assert result.p_target is None
+            assert result.endpoints.size == 0
+        else:
+            assert result.endpoints.shape == (20_000,)
+    selected = select_robust_design(params, evaluations, results)
+    if selected is not None:
+        probability = results[selected.design].p_target
+        assert probability is not None
+        assert probability >= params.target_probability
