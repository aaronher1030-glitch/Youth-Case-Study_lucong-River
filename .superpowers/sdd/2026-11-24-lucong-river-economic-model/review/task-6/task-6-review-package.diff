+def test_run_uncertainty_excludes_infeasible_designs_and_uses_one_shared_draw_object(
+    monkeypatch,
+):
+    params = replace(Params(), land_available_ha=20.0)
+    sheds = load_census(FIXTURE)
+    evaluations = enumerate_designs(params, sheds)
+    infeasible = replace(
+        evaluations[0], checks={**evaluations[0].checks, "budget": False}
+    )
+    evaluations = [infeasible, *evaluations[1:]]
+    spec = UncertaintySpec(n_draws=128, seed=2026)
+    real_make_draws = uncertainty_module.make_draws
+    calls: list[tuple[int, int]] = []
+
+    def recording_make_draws(received_spec, n, seed):
+        calls.append((n, seed))
+        return real_make_draws(received_spec, n, seed)
+
+    monkeypatch.setattr(uncertainty_module, "make_draws", recording_make_draws)
+    results = run_uncertainty(params, sheds, evaluations, spec)
+    assert calls == [(128, 2026)]
+    feasible = [row for row in evaluations if constraint_feasible(row)]
+    assert set(results) == {row.design for row in feasible}
+    assert infeasible.design not in results
+
+    shared = real_make_draws(spec, 128, 2026)
+    for row in feasible:
+        expected = evaluate_design_uncertainty(params, sheds, row, shared)
+        actual = results[row.design]
+        assert actual.p_target == expected.p_target
+        assert actual.invalid_fraction == expected.invalid_fraction
+        assert actual.valid_draws == expected.valid_draws
+        assert (
+            actual.c_end_p10,
+            actual.c_end_p50,
+            actual.c_end_p90,
+            actual.eac_p10,
+            actual.eac_p50,
+            actual.eac_p90,
+        ) == (
+            expected.c_end_p10,
+            expected.c_end_p50,
+            expected.c_end_p90,
+            expected.eac_p10,
+            expected.eac_p50,
+            expected.eac_p90,
+        )
+        np.testing.assert_array_equal(actual.endpoints, expected.endpoints)
