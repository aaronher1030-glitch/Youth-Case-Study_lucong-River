+from __future__ import annotations
+
+import math
+from dataclasses import replace
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from river_model import uncertainty as uncertainty_module
+from river_model.design import (
+    Design,
+    DesignEvaluation,
+    constraint_feasible,
+    enumerate_designs,
+)
+from river_model.inputs import Params, Shed, load_census
+from river_model.uncertainty import (
+    MonteCarloResult,
+    UncertaintySpec,
+    evaluate_design_uncertainty,
+    make_draws,
+    one_at_a_time,
+    run_uncertainty,
+    select_robust_design,
+)
+
+FIXTURE = Path(__file__).parent / "fixtures" / "census.csv"
+DRAW_KEYS = {
+    "q",
+    "e",
+    "eta",
+    "p_enroll",
+    "p_collect",
+    "p_retain",
+    "cost_multiplier",
+}
+TRIANGULAR_FIELDS = (
+    ("eta", True),
+    ("p_enroll", True),
+    ("p_collect", True),
+    ("p_retain", True),
+    ("cost_multiplier", False),
+)
+
+
+def _evaluation(
+    params: Params | None = None, sheds: tuple[Shed, ...] | None = None
+) -> DesignEvaluation:
+    if params is None:
+        params = replace(Params(), land_available_ha=20.0)
+    if sheds is None:
+        sheds = load_census(FIXTURE)
+    return enumerate_designs(params, sheds)[0]
+
+
+def _draws(**overrides: object) -> dict[str, np.ndarray]:
+    values: dict[str, object] = {
+        "q": np.array([1.0]),
+        "e": np.array([1.0e8]),
+        "eta": np.array([0.5]),
+        "p_enroll": np.array([1.0]),
+        "p_collect": np.array([1.0]),
+        "p_retain": np.array([1.0]),
+        "cost_multiplier": np.array([1.0]),
+    }
+    values.update(overrides)
+    return {key: np.asarray(value, dtype=float) for key, value in values.items()}
+
+
+def _probability_result(probability: float | None) -> MonteCarloResult:
+    return MonteCarloResult(
+        p_target=probability,
+        c_end_p10=None,
+        c_end_p50=None,
+        c_end_p90=None,
+        eac_p10=None,
+        eac_p50=None,
+        eac_p90=None,
+        invalid_fraction=0.0,
+        valid_draws=1,
+        endpoints=np.empty(0, dtype=float),
+    )
+
+
+def _candidate(
+    base: DesignEvaluation,
+    *,
+    shed_ids: tuple[str, ...],
+    eac: float,
+    cash_12m: float,
+    modules: int = 1,
+) -> DesignEvaluation:
+    return replace(
+        base,
+        design=Design(
+            shed_ids=shed_ids,
+            modules=modules,
+            tankers=1,
+            carts=1,
+            collection_days_week=1,
+        ),
+        costs=replace(base.costs, eac=eac, cash_12m=cash_12m),
+    )
+
+
+def test_production_defaults_are_twenty_thousand_draws_and_seed_2026():
+    spec = UncertaintySpec()
+    assert spec.n_draws == 20_000
+    assert spec.seed == 2026
+    assert Params().target_probability == 0.80
+
+
+def test_fixed_seed_is_reproducible_and_different_seed_changes_every_draw():
+    spec = UncertaintySpec()
+    first = make_draws(spec, 100, 2026)
+    repeated = make_draws(spec, 100, 2026)
+    different = make_draws(spec, 100, 2027)
+    assert set(first) == DRAW_KEYS
+    for key in DRAW_KEYS:
+        assert first[key].shape == (100,)
+        assert np.array_equal(first[key], repeated[key])
+        assert not np.array_equal(first[key], different[key])
+
+
+def test_log_uniform_and_triangular_draws_follow_the_specified_numpy_streams():
+    spec = UncertaintySpec(
+        q_low=0.01,
+        q_high=0.04,
+        e_low=2.0e8,
+        e_high=9.0e8,
+        eta_low=0.2,
+        eta_mode=0.7,
+        eta_high=0.9,
+        p_enroll_low=0.1,
+        p_enroll_mode=0.4,
+        p_enroll_high=0.8,
+        p_collect_low=0.3,
+        p_collect_mode=0.5,
+        p_collect_high=1.0,
+        p_retain_low=0.6,
+        p_retain_mode=0.8,
+        p_retain_high=0.95,
+        cost_low=0.5,
+        cost_mode=1.2,
+        cost_high=2.0,
+    )
+    n = 128
+    actual = make_draws(spec, n, 73)
+    rng = np.random.default_rng(73)
+    expected_q = np.exp(rng.uniform(math.log(0.01), math.log(0.04), n))
+    expected_e = np.exp(rng.uniform(math.log(2.0e8), math.log(9.0e8), n))
+    expected_eta = rng.triangular(0.2, 0.7, 0.9, n)
+    expected_enroll = rng.triangular(0.1, 0.4, 0.8, n)
+    expected_collect = rng.triangular(0.3, 0.5, 1.0, n)
+    expected_retain = rng.triangular(0.6, 0.8, 0.95, n)
+    expected_cost = rng.triangular(0.5, 1.2, 2.0, n)
